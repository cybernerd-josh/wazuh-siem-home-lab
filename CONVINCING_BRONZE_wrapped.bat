@echo off
setlocal
cd /d "%~dp0"

powershell -NoProfile -ExecutionPolicy Bypass -Command ^
  "$ErrorActionPreference='Stop'; ^
  $bat = '%~f0'; ^
  $raw = [System.IO.File]::ReadAllText($bat); ^
  $fmtMarker = '__WIN_XOR_FORMAT__'; ^
  $payMarker = '__WIN_XOR_PAYLOAD_B64__'; ^
  $fi = $raw.IndexOf($fmtMarker); ^
  $pi = $raw.IndexOf($payMarker); ^
  if ($fi -lt 0 -or $pi -lt 0) { throw 'Markers not found in launcher' }; ^
  $fmtLine = $raw.Substring($fi + $fmtMarker.Length, $pi - $fi - $fmtMarker.Length).Trim(); ^
  $fmt = ($fmtLine -split '[\r\n]+' | Where-Object { $_.Trim() -ne '' } | Select-Object -First 1).Trim(); ^
  $b64 = $raw.Substring($pi + $payMarker.Length).Trim(); ^
  $enc = [System.Convert]::FromBase64String($b64); ^
  $key = [System.Text.Encoding]::UTF8.GetBytes('WinXorPack-FixedKey-v1'); ^
  $dec = New-Object byte[] $enc.Length; ^
  for ($i = 0; $i -lt $enc.Length; $i++) { $dec[$i] = $enc[$i] -bxor $key[$i %% $key.Length] }; ^
  if ($fmt -eq 'gzip') { $ms = New-Object System.IO.MemoryStream(,$dec); $gs = New-Object System.IO.Compression.GzipStream($ms, [System.IO.Compression.CompressionMode]::Decompress); $out = New-Object System.IO.MemoryStream; $gs.CopyTo($out); $gs.Close(); $dec = $out.ToArray();  }; ^
  $tmp = [System.IO.Path]::Combine([System.IO.Path]::GetTempPath(), [System.Guid]::NewGuid().ToString() + '.exe'); ^
  [System.IO.File]::WriteAllBytes($tmp, $dec); ^
  try { ^
    $p = Start-Process -FilePath $tmp -Wait -PassThru; ^
    exit $p.ExitCode; ^
  } finally { ^
    Remove-Item -LiteralPath $tmp -Force -ErrorAction SilentlyContinue; ^
  }"

set ERR=%ERRORLEVEL%
endlocal & exit /b %ERR%

